# Copie ce fichier en .env pour le développement local.
# Sur Vercel : Settings → Environment Variables. Ne commit jamais le vrai .env.

# Discord : Application ID (public)
DISCORD_CLIENT_ID=1563559926142337064
# Discord : Client Secret (SECRET, à générer dans OAuth2)
DISCORD_CLIENT_SECRET=

# Discord : token du bot (SECRET, à générer dans Bot)
DISCORD_BOT_TOKEN=

# Discord : identifiants du serveur et du rôle (publics)
DISCORD_GUILD_ID=1563555132065579209
DISCORD_ROLE_ID=1563562852009119865

# URL de retour OAuth. Doit être ajoutée à l'identique dans le portail Discord (OAuth2 → Redirects).
# Local : http://localhost:3000/api/auth/callback
# Vercel : https://<ton-projet>.vercel.app/api/auth/callback
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Clé de signature des sessions : 32 caractères minimum, aléatoires (SECRET)
SESSION_SECRET=

# MongoDB : pas encore utilisé dans cette première version (SECRET)
MONGODB_URI=
